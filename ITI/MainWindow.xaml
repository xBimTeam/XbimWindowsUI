<Window x:Class="ITI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IFC Viewer" Height="600" Width="800">
    <Grid>
        <Viewport3D Name="viewport">
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>
        <Button Content="Load IFC" Click="LoadIfc_Click" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    </Grid>
</Window>
